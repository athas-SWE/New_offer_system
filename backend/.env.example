NODE_ENV=development
PORT=3000

# Preferred: single MySQL connection URL
# Prisma uses this URL. For local MySQL omit ssl-mode.
# Managed MySQL/Cloud SQL example: .../offer_lanka?sslaccept=strict
DATABASE_URL="mysql://root:root@127.0.0.1:3306/offer_lanka"

# Fallback discrete vars (used only when DATABASE_URL is unset)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=offer_lanka

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:4200

# Swagger UI at /api/docs (set false in production if desired)
SWAGGER_ENABLED=true

# Uploads (max size for multipart; files go to Cloudinary)
MAX_FILE_SIZE=5242880

# Cloudinary — Dashboard → Account Details → API Keys
CLOUDINARY_CLOUD_NAME=derggujli
CLOUDINARY_API_KEY=963343752895722
CLOUDINARY_API_SECRET=4NI98b8h9UFvyOBtcGNFdHgI5xA
CLOUDINARY_FOLDER=offer-lanka


# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Seed admin (optional)
SEED_ON_BOOT=true
SEED_ADMIN_EMAIL=admin@offerlanka.lk
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=System Admin

# Firebase Admin (optional)
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
