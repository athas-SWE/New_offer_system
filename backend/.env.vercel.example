# Copy these into Vercel → Project → Settings → Environment Variables
# (Production + Preview). Never commit real values.

NODE_ENV=production

# Aiven MySQL — Overview → Connection information → Service URI
# URL-encode special characters in the password. Keep ssl-mode=REQUIRED.
DATABASE_URL=mysql://avnadmin:ENCODED_PASSWORD@mysql-XXXX.d.aivencloud.com:PORT/defaultdb?ssl-mode=REQUIRED

# Optional: paste Aiven CA certificate (Overview → CA certificate). Use \n for newlines.
# AIVEN_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origin(s), comma-separated
CORS_ORIGIN=https://your-frontend.vercel.app

# Optional override (otherwise Vercel sets VERCEL_URL)
# PUBLIC_API_URL=https://your-api.vercel.app
PUBLIC_SITE_URL=https://your-frontend.vercel.app

SWAGGER_ENABLED=true
SEED_ON_BOOT=true
SEED_ADMIN_EMAIL=admin@offerlanka.lk
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=System Admin

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=offer-lanka

# Vercel Hobby body limit is ~4.5MB
MAX_FILE_SIZE=4194304

THROTTLE_TTL=60
THROTTLE_LIMIT=100
DB_POOL_SIZE=2

FACEBOOK_GRAPH_API_VERSION=v25.0
FACEBOOK_PUBLISH_ENABLED=true
FACEBOOK_TOKEN_ENCRYPTION_KEY=
FACEBOOK_REDIRECT_URI=https://your-api.vercel.app/api/shops/facebook/callback

FIREBASE_ENABLED=false
