// Offer Lanka — Prisma schema (MySQL)
// Run: npx prisma migrate dev --name initial_migrate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  BUSINESS_OWNER
  CUSTOMER
}

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum OfferStatus {
  DRAFT
  PENDING
  ACTIVE
  EXPIRED
  REJECTED
  INACTIVE
}

enum NotificationType {
  SYSTEM
  OFFER
  REVIEW
  BUSINESS
  PROMO
}

enum ListingStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum PriceUnit {
  FIXED
  FROM
  HOURLY
  PER_DAY
  PER_HOUR
}

enum PosPaymentMethod {
  CASH
  CARD
  OTHER
}

model Role {
  id          String    @id @default(uuid()) @db.Char(36)
  name        RoleName  @unique
  description String?   @db.VarChar(255)
  createdBy   String?   @map("created_by") @db.VarChar(36)
  updatedBy   String?   @map("updated_by") @db.VarChar(36)
  createdDate DateTime  @default(now()) @map("created_date") @db.DateTime(6)
  updatedDate DateTime  @default(now()) @updatedAt @map("updated_date") @db.DateTime(6)
  isDeleted   Boolean   @default(false) @map("is_deleted")
  users       User[]

  @@map("roles")
}

model District {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String    @db.VarChar(120)
  slug        String    @unique @db.VarChar(140)
  province    String?   @db.VarChar(120)
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   String?   @map("created_by") @db.VarChar(36)
  updatedBy   String?   @map("updated_by") @db.VarChar(36)
  createdDate DateTime  @default(now()) @map("created_date") @db.DateTime(6)
  updatedDate DateTime  @default(now()) @updatedAt @map("updated_date") @db.DateTime(6)
  isDeleted   Boolean   @default(false) @map("is_deleted")
  cities      City[]

  @@map("districts")
}

model City {
  id          String     @id @default(uuid()) @db.Char(36)
  name        String     @db.VarChar(120)
  slug        String     @unique @db.VarChar(140)
  isActive    Boolean    @default(true) @map("is_active")
  districtId  String     @map("district_id") @db.Char(36)
  createdBy   String?    @map("created_by") @db.VarChar(36)
  updatedBy   String?    @map("updated_by") @db.VarChar(36)
  createdDate DateTime   @default(now()) @map("created_date") @db.DateTime(6)
  updatedDate DateTime   @default(now()) @updatedAt @map("updated_date") @db.DateTime(6)
  isDeleted   Boolean    @default(false) @map("is_deleted")
  district    District   @relation(fields: [districtId], references: [id])
  shops       Shop[]
  offers      Offer[]
  services    ServiceListing[]
  rentals     Rental[]

  @@map("cities")
}

model User {
  id               String         @id @default(uuid()) @db.Char(36)
  name             String         @db.VarChar(150)
  email            String         @unique @db.VarChar(180)
  passwordHash     String         @map("password_hash") @db.VarChar(255)
  phone            String?        @db.VarChar(30)
  avatarUrl        String?        @map("avatar_url") @db.VarChar(500)
  isActive         Boolean        @default(true) @map("is_active")
  refreshTokenHash String?        @map("refresh_token_hash") @db.VarChar(255)
  fcmToken         String?        @map("fcm_token") @db.VarChar(512)
  roleId           String         @map("role_id") @db.Char(36)
  createdBy        String?        @map("created_by") @db.VarChar(36)
  updatedBy        String?        @map("updated_by") @db.VarChar(36)
  createdDate      DateTime       @default(now()) @map("created_date") @db.DateTime(6)
  updatedDate      DateTime       @default(now()) @updatedAt @map("updated_date") @db.DateTime(6)
  isDeleted        Boolean        @default(false) @map("is_deleted")
  role             Role           @relation(fields: [roleId], references: [id])
  shops            Shop[]
  favorites        Favorite[]
  notifications    Notification[]
  reviews          Review[]

  @@map("users")
}

model Shop {
  id                 String          @id @default(uuid()) @db.Char(36)
  name               String          @db.VarChar(200)
  description        String?         @db.Text
  registrationNumber String?         @map("registration_number") @db.VarChar(100)
  email              String?         @db.VarChar(180)
  phone              String?         @db.VarChar(30)
  address            String?         @db.VarChar(500)
  locationUrl        String?         @map("location_url") @db.VarChar(1000)
  logoUrl            String?         @map("logo_url") @db.VarChar(500)
  website            String?         @db.VarChar(500)
  instagramUrl       String?         @map("instagram_url") @db.VarChar(500)
  facebookUrl        String?         @map("facebook_url") @db.VarChar(500)
  status             BusinessStatus  @default(PENDING)
  isActive           Boolean         @default(true) @map("is_active")
  posEnabled         Boolean         @default(false) @map("pos_enabled")
  latitude           Decimal?        @db.Decimal(10, 7)
  longitude          Decimal?        @db.Decimal(10, 7)
  ownerId            String          @map("owner_id") @db.Char(36)
  cityId             String?         @map("city_id") @db.Char(36)
  createdBy          String?         @map("created_by") @db.VarChar(36)
  updatedBy          String?         @map("updated_by") @db.VarChar(36)
  createdDate        DateTime        @default(now()) @map("created_date") @db.DateTime(6)
  updatedDate        DateTime        @default(now()) @updatedAt @map("updated_date") @db.DateTime(6)
  isDeleted          Boolean         @default(false) @map("is_deleted")
  owner              User            @relation(fields: [ownerId], references: [id])
  city               City?           @relation(fields: [cityId], references: [id])
  offers             Offer[]
  services           ServiceListing[]
  rentals            Rental[]
  posProducts        PosProduct[]
  posSales           PosSale[]

  @@map("shops")
}

model PosProduct {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String    @db.VarChar(200)
  sku         String?   @db.VarChar(80)
  price       Decimal   @default(0) @db.Decimal(12, 2)
  stock       Int?
  image       String?   @db.VarChar(500)
  isActive    Boolean   @default(true) @map("is_active")
  shopId      String    @map("shop_id") @db.Char(36)
  createdBy   String?   @map("created_by") @db.VarChar(36)
  updatedBy   String?   @map("updated_by") @db.VarChar(36)
  createdDate DateTime  @default(now()) @map("created_date") @db.DateTime(6)
  updatedDate DateTime  @default(now()) @updatedAt @map("updated_date") @db.DateTime(6)
  isDeleted   Boolean   @default(false) @map("is_deleted")
  shop        Shop      @relation(fields: [shopId], references: [id])
  saleItems   PosSaleItem[]

  @@map("pos_products")
}

model PosSale {
  id             String           @id @default(uuid()) @db.Char(36)
  receiptNumber  String           @unique @map("receipt_number") @db.VarChar(40)
  subtotal       Decimal          @default(0) @db.Decimal(12, 2)
  discount       Decimal          @default(0) @db.Decimal(12, 2)
  total          Decimal          @default(0) @db.Decimal(12, 2)
  paymentMethod  PosPaymentMethod @default(CASH) @map("payment_method")
  note           String?          @db.VarChar(500)
  shopId         String           @map("shop_id") @db.Char(36)
  createdBy      String?          @map("created_by") @db.VarChar(36)
  updatedBy      String?          @map("updated_by") @db.VarChar(36)
  createdDate    DateTime         @default(now()) @map("created_date") @db.DateTime(6)
  updatedDate    DateTime         @default(now()) @updatedAt @map("updated_date") @db.DateTime(6)
  isDeleted      Boolean          @default(false) @map("is_deleted")
  shop           Shop             @relation(fields: [shopId], references: [id])
  items          PosSaleItem[]

  @@map("pos_sales")
}

model PosSaleItem {
  id          String      @id @default(uuid()) @db.Char(36)
  saleId      String      @map("sale_id") @db.Char(36)
  productId   String?     @map("product_id") @db.Char(36)
  productName String      @map("product_name") @db.VarChar(200)
  unitPrice   Decimal     @default(0) @map("unit_price") @db.Decimal(12, 2)
  quantity    Int         @default(1)
  lineTotal   Decimal     @default(0) @map("line_total") @db.Decimal(12, 2)
  createdBy   String?     @map("created_by") @db.VarChar(36)
  updatedBy   String?     @map("updated_by") @db.VarChar(36)
  createdDate DateTime    @default(now()) @map("created_date") @db.DateTime(6)
  updatedDate DateTime    @default(now()) @updatedAt @map("updated_date") @db.DateTime(6)
  isDeleted   Boolean     @default(false) @map("is_deleted")
  sale        PosSale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     PosProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("pos_sale_items")
}

model Category {
  id          String     @id @default(uuid()) @db.Char(36)
  name        String     @db.VarChar(150)
  slug        String     @unique @db.VarChar(160)
  description String?    @db.Text
  iconUrl     String?    @map("icon_url") @db.VarChar(500)
  sortOrder   Int        @default(0) @map("sort_order")
  isActive    Boolean    @default(true) @map("is_active")
  parentId    String?    @map("parent_id") @db.Char(36)
  createdBy   String?    @map("created_by") @db.VarChar(36)
  updatedBy   String?    @map("updated_by") @db.VarChar(36)
  createdDate DateTime   @default(now()) @map("created_date") @db.DateTime(6)
  updatedDate DateTime   @default(now()) @updatedAt @map("updated_date") @db.DateTime(6)
  isDeleted   Boolean    @default(false) @map("is_deleted")
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  offers      Offer[]
  services    ServiceListing[]
  rentals     Rental[]

  @@map("categories")
}

model Offer {
  id              String        @id @default(uuid()) @db.Char(36)
  title           String        @db.VarChar(250)
  description     String?       @db.Text
  discountPercent Decimal       @default(0) @map("discount_percent") @db.Decimal(5, 2)
  originalPrice   Decimal?      @map("original_price") @db.Decimal(12, 2)
  offerPrice      Decimal?      @map("offer_price") @db.Decimal(12, 2)
  startDate       DateTime      @map("start_date")
  endDate         DateTime      @map("end_date")
  couponCode      String?       @map("coupon_code") @db.VarChar(50)
  image           String?       @db.VarChar(500)
  latitude        Decimal?      @db.Decimal(10, 7)
  longitude       Decimal?      @db.Decimal(10, 7)
  qrCode          String?       @map("qr_code") @db.VarChar(500)
  views           Int           @default(0)
  likes           Int           @default(0)
  status          OfferStatus   @default(DRAFT)
  shopId          String        @map("shop_id") @db.Char(36)
  categoryId      String?       @map("category_id") @db.Char(36)
  cityId          String?       @map("city_id") @db.Char(36)
  createdBy       String?       @map("created_by") @db.VarChar(36)
  updatedBy       String?       @map("updated_by") @db.VarChar(36)
  createdDate     DateTime      @default(now()) @map("created_date") @db.DateTime(6)
  updatedDate     DateTime      @default(now()) @updatedAt @map("updated_date") @db.DateTime(6)
  isDeleted       Boolean       @default(false) @map("is_deleted")
  shop            Shop          @relation(fields: [shopId], references: [id])
  category        Category?     @relation(fields: [categoryId], references: [id])
  city            City?         @relation(fields: [cityId], references: [id])
  images          OfferImage[]
  favorites       Favorite[]
  reviews         Review[]

  @@map("offers")
}

model ServiceListing {
  id          String        @id @default(uuid()) @db.Char(36)
  title       String        @db.VarChar(250)
  description String?       @db.Text
  price       Decimal?      @db.Decimal(12, 2)
  priceUnit   PriceUnit     @default(FIXED) @map("price_unit")
  image       String?       @db.VarChar(500)
  status      ListingStatus @default(DRAFT)
  shopId      String        @map("shop_id") @db.Char(36)
  categoryId  String?       @map("category_id") @db.Char(36)
  cityId      String?       @map("city_id") @db.Char(36)
  createdBy   String?       @map("created_by") @db.VarChar(36)
  updatedBy   String?       @map("updated_by") @db.VarChar(36)
  createdDate DateTime      @default(now()) @map("created_date") @db.DateTime(6)
  updatedDate DateTime      @default(now()) @updatedAt @map("updated_date") @db.DateTime(6)
  isDeleted   Boolean       @default(false) @map("is_deleted")
  shop        Shop          @relation(fields: [shopId], references: [id])
  category    Category?     @relation(fields: [categoryId], references: [id])
  city        City?         @relation(fields: [cityId], references: [id])

  @@map("services")
}

model Rental {
  id               String        @id @default(uuid()) @db.Char(36)
  title            String        @db.VarChar(250)
  description      String?       @db.Text
  price            Decimal?      @db.Decimal(12, 2)
  priceUnit        PriceUnit     @default(PER_DAY) @map("price_unit")
  deposit          Decimal?      @db.Decimal(12, 2)
  availabilityNote String?       @map("availability_note") @db.VarChar(500)
  image            String?       @db.VarChar(500)
  status           ListingStatus @default(DRAFT)
  shopId           String        @map("shop_id") @db.Char(36)
  categoryId       String?       @map("category_id") @db.Char(36)
  cityId           String?       @map("city_id") @db.Char(36)
  createdBy        String?       @map("created_by") @db.VarChar(36)
  updatedBy        String?       @map("updated_by") @db.VarChar(36)
  createdDate      DateTime      @default(now()) @map("created_date") @db.DateTime(6)
  updatedDate      DateTime      @default(now()) @updatedAt @map("updated_date") @db.DateTime(6)
  isDeleted        Boolean       @default(false) @map("is_deleted")
  shop             Shop          @relation(fields: [shopId], references: [id])
  category         Category?     @relation(fields: [categoryId], references: [id])
  city             City?         @relation(fields: [cityId], references: [id])

  @@map("rentals")
}

model OfferImage {
  id          String   @id @default(uuid()) @db.Char(36)
  imageUrl    String   @map("image_url") @db.VarChar(500)
  sortOrder   Int      @default(0) @map("sort_order")
  isPrimary   Boolean  @default(false) @map("is_primary")
  offerId     String   @map("offer_id") @db.Char(36)
  createdBy   String?  @map("created_by") @db.VarChar(36)
  updatedBy   String?  @map("updated_by") @db.VarChar(36)
  createdDate DateTime @default(now()) @map("created_date") @db.DateTime(6)
  updatedDate DateTime @default(now()) @updatedAt @map("updated_date") @db.DateTime(6)
  isDeleted   Boolean  @default(false) @map("is_deleted")
  offer       Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@map("offer_images")
}

model Favorite {
  id          String   @id @default(uuid()) @db.Char(36)
  userId      String   @map("user_id") @db.Char(36)
  offerId     String   @map("offer_id") @db.Char(36)
  createdBy   String?  @map("created_by") @db.VarChar(36)
  updatedBy   String?  @map("updated_by") @db.VarChar(36)
  createdDate DateTime @default(now()) @map("created_date") @db.DateTime(6)
  updatedDate DateTime @default(now()) @updatedAt @map("updated_date") @db.DateTime(6)
  isDeleted   Boolean  @default(false) @map("is_deleted")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer       Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([userId, offerId], map: "uq_favorites_user_offer")
  @@map("favorites")
}

model Notification {
  id          String           @id @default(uuid()) @db.Char(36)
  title       String           @db.VarChar(200)
  message     String           @db.Text
  type        NotificationType @default(SYSTEM)
  isRead      Boolean          @default(false) @map("is_read")
  referenceId String?          @map("reference_id") @db.VarChar(36)
  userId      String           @map("user_id") @db.Char(36)
  createdBy   String?          @map("created_by") @db.VarChar(36)
  updatedBy   String?          @map("updated_by") @db.VarChar(36)
  createdDate DateTime         @default(now()) @map("created_date") @db.DateTime(6)
  updatedDate DateTime         @default(now()) @updatedAt @map("updated_date") @db.DateTime(6)
  isDeleted   Boolean          @default(false) @map("is_deleted")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Review {
  id          String   @id @default(uuid()) @db.Char(36)
  rating      Int
  comment     String?  @db.Text
  isApproved  Boolean  @default(true) @map("is_approved")
  userId      String   @map("user_id") @db.Char(36)
  offerId     String   @map("offer_id") @db.Char(36)
  createdBy   String?  @map("created_by") @db.VarChar(36)
  updatedBy   String?  @map("updated_by") @db.VarChar(36)
  createdDate DateTime @default(now()) @map("created_date") @db.DateTime(6)
  updatedDate DateTime @default(now()) @updatedAt @map("updated_date") @db.DateTime(6)
  isDeleted   Boolean  @default(false) @map("is_deleted")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer       Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Analytics {
  id          String   @id @default(uuid()) @db.Char(36)
  eventType   String   @map("event_type") @db.VarChar(80)
  entityType  String?  @map("entity_type") @db.VarChar(80)
  entityId    String?  @map("entity_id") @db.VarChar(36)
  userId      String?  @map("user_id") @db.VarChar(36)
  businessId  String?  @map("business_id") @db.VarChar(36)
  metadata    Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdBy   String?  @map("created_by") @db.VarChar(36)
  updatedBy   String?  @map("updated_by") @db.VarChar(36)
  createdDate DateTime @default(now()) @map("created_date") @db.DateTime(6)
  updatedDate DateTime @default(now()) @updatedAt @map("updated_date") @db.DateTime(6)
  isDeleted   Boolean  @default(false) @map("is_deleted")

  @@map("analytics")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Char(36)
  action      String   @db.VarChar(80)
  entityType  String   @map("entity_type") @db.VarChar(80)
  entityId    String?  @map("entity_id") @db.VarChar(36)
  userId      String?  @map("user_id") @db.VarChar(36)
  changes     Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdBy   String?  @map("created_by") @db.VarChar(36)
  updatedBy   String?  @map("updated_by") @db.VarChar(36)
  createdDate DateTime @default(now()) @map("created_date") @db.DateTime(6)
  updatedDate DateTime @default(now()) @updatedAt @map("updated_date") @db.DateTime(6)
  isDeleted   Boolean  @default(false) @map("is_deleted")

  @@map("audit_logs")
}

model HeroSlide {
  id          String   @id @default(uuid()) @db.Char(36)
  title       String   @db.VarChar(200)
  subtitle    String?  @db.VarChar(500)
  imageUrl    String   @map("image_url") @db.VarChar(700)
  ctaLabel    String?  @map("cta_label") @db.VarChar(80)
  ctaLink     String?  @map("cta_link") @db.VarChar(300)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String?  @map("created_by") @db.VarChar(36)
  updatedBy   String?  @map("updated_by") @db.VarChar(36)
  createdDate DateTime @default(now()) @map("created_date") @db.DateTime(6)
  updatedDate DateTime @default(now()) @updatedAt @map("updated_date") @db.DateTime(6)
  isDeleted   Boolean  @default(false) @map("is_deleted")

  @@map("hero_slides")
}
