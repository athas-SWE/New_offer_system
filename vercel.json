{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{dist/**,lib/**,node_modules/swagger-ui-dist/**}"
    },
    "api/[...path].js": {
      "includeFiles": "{dist/**,lib/**,node_modules/swagger-ui-dist/**}"
    }
  }
}
