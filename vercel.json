{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/", "destination": "/api" }
  ],
  "functions": {
    "api/[[...path]].js": {
      "includeFiles": "{dist/**,node_modules/swagger-ui-dist/**}"
    }
  }
}
