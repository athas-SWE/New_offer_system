NODE_ENV=development
PORT=3000

# Preferred: single MySQL connection URL (local, Aiven, or other managed MySQL)
# Prisma uses this URL. For local MySQL omit ssl-mode.
# Aiven (Vercel): copy Service URI from the Aiven console, URL-encode the password,
# and keep ssl-mode=REQUIRED. Example:
# DATABASE_URL="mysql://avnadmin:ENCODED_PASSWORD@mysql-xxxx.d.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED"
DATABASE_URL="mysql://root:root@127.0.0.1:3306/offer_lanka"

# Fallback discrete vars (used only when DATABASE_URL is unset)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=offer_lanka
# SSL: unset = auto (on for Aiven / Vercel / production). true | false | strict
# DB_SSL=true
# Optional Aiven CA (paste PEM; use \n for newlines). Enables verify-full when set.
# AIVEN_CA_CERT=
# Serverless-friendly pool (Vercel defaults to 2)
# DB_POOL_SIZE=2
# DB_CONNECT_TIMEOUT=20000

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated origins). Production: https://your-frontend.vercel.app
CORS_ORIGIN=http://localhost:4200
# Public API URL (Swagger server + Facebook callbacks). Vercel sets VERCEL_URL automatically.
# PUBLIC_API_URL=https://your-api.vercel.app

# Swagger UI at /api/docs (set false in production if desired)
SWAGGER_ENABLED=true

# Uploads (max size for multipart; files go to Cloudinary)
MAX_FILE_SIZE=5242880

# Cloudinary — Dashboard → Account Details → API Keys
CLOUDINARY_CLOUD_NAME=derggujli
CLOUDINARY_API_KEY=963343752895722
CLOUDINARY_API_SECRET=4NI98b8h9UFvyOBtcGNFdHgI5xA
CLOUDINARY_FOLDER=offer-lanka


# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Seed admin (optional)
SEED_ON_BOOT=true
SEED_ADMIN_EMAIL=admin@offerlanka.lk
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=System Admin

# Firebase Admin (optional)
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Facebook / Meta Graph API — each shop configures their own Page token in the dashboard
FACEBOOK_GRAPH_API_VERSION=v25.0
FACEBOOK_POSTS_CACHE_TTL_SEC=60
FACEBOOK_PUBLISH_ENABLED=true
FACEBOOK_MAX_RETRIES=1
FACEBOOK_RETRY_BASE_MS=1000
FACEBOOK_IMAGE_SIGNED_URL_TTL_SEC=3600
# Required to encrypt shop Page tokens at rest
FACEBOOK_TOKEN_ENCRYPTION_KEY=change-me-to-a-64-char-hex-or-long-secret
PUBLIC_SITE_URL=http://localhost:4200

# Optional: Facebook Login button (Meta app OAuth)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/shops/facebook/callback
