# =============================================================================
# Offer Lanka — root environment example
# Copy to .env and fill in values. Never commit real secrets.
# =============================================================================

# --- App ---
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200
API_BASE_URL=http://localhost:3000/api

# --- Backend ---
PORT=3000
BACKEND_PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- MySQL (local or Aiven) ---
# Aiven: paste Service URI from the console (ssl-mode=REQUIRED). URL-encode special chars in the password.
DATABASE_URL="mysql://root:root@127.0.0.1:3306/offer_lanka"

MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=offer_lanka
MYSQL_USER=root
MYSQL_PASSWORD=root

# Fallback Nest/TypeORM discrete vars (when DATABASE_URL is unset)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=offer_lanka
DB_SYNC=false
DB_LOGGING=true
# DB_SSL=true
# AIVEN_CA_CERT=
# DB_POOL_SIZE=2

# --- Redis (optional) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Frontend ---
FRONTEND_PORT=4200
# Angular environment / runtime config
NG_APP_API_BASE_URL=http://localhost:3000/api

# --- Firebase (frontend + admin) ---
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Path to service account JSON for Nest firebase-admin (local only)
GOOGLE_APPLICATION_CREDENTIALS=

# --- Facebook / Meta Graph API (each shop configures own Page in dashboard) ---
FACEBOOK_GRAPH_API_VERSION=v25.0
FACEBOOK_POSTS_CACHE_TTL_SEC=60
FACEBOOK_PUBLISH_ENABLED=true
FACEBOOK_MAX_RETRIES=1
FACEBOOK_RETRY_BASE_MS=1000
FACEBOOK_IMAGE_SIGNED_URL_TTL_SEC=3600
FACEBOOK_TOKEN_ENCRYPTION_KEY=change-me-to-a-64-char-hex-or-long-secret
PUBLIC_SITE_URL=http://localhost:4200
# Optional Facebook Login OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/shops/facebook/callback

# --- Deploy (Vercel + Aiven) ---
# Backend: Vercel project Root Directory = backend
# PUBLIC_API_URL=https://your-api.vercel.app
# CORS_ORIGIN=https://your-frontend.vercel.app
# See backend/README.md → Deploy to Vercel + Aiven
