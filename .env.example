# =============================================================================
# Offer Lanka — root environment example
# Copy to .env and fill in values. Never commit real secrets.
# =============================================================================

# --- App ---
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200
API_BASE_URL=http://localhost:3000/api

# --- Backend ---
PORT=3000
BACKEND_PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- MySQL ---
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=offer_lanka
MYSQL_USER=offerlanka
MYSQL_PASSWORD=offerlanka

# Nest/TypeORM style (host app talking to Docker MySQL on localhost)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=offerlanka
DB_PASSWORD=offerlanka
DB_DATABASE=offer_lanka
DB_SYNC=false
DB_LOGGING=true

# --- Redis (optional) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Frontend ---
FRONTEND_PORT=4200
# Angular environment / runtime config
NG_APP_API_BASE_URL=http://localhost:3000/api

# --- Firebase (frontend + admin) ---
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Path to service account JSON for Nest firebase-admin (local only)
GOOGLE_APPLICATION_CREDENTIALS=

# --- GCP / deploy placeholders ---
GCP_PROJECT_ID=
GCP_REGION=asia-south1
CLOUD_RUN_SERVICE=offer-lanka-api
ARTIFACT_REGISTRY=asia-south1-docker.pkg.dev
ARTIFACT_REPO=offer-lanka
